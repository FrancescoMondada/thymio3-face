{
  "name": "thymio3-face",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A smartphone laid on a Thymio 3 becomes its face: eyes, mouth, camera. The robot introduces itself.",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "model": "node scripts/fetch-model.mjs",
    "test": "node --test tests/*.test.js && python3 -I tests/test_table_edge.py && python3 -I tests/test_hand_sensor.py",
    "api:update": "npm update thymio3-ts-api"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "thymio3-ts-api": "github:Mobsya/thymio3-ts-api#main"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  }
}
